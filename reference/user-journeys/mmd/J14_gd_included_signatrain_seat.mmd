    direction TB
    U1["Activate account or sign in"]
    END(["User enters Signatrain HR without user payment"])
  end
  G1 --> P1
  P1 --> D1
  D1 -->|"Concierge"| P2
  D1 -->|"All Access"| P3
  D1 -->|"Custom"| P4
  P2 --> C1
  P3 --> C1
  P4 --> C1
  C1 --> C2
  C2 --> P5
  P5 --> U1
  U1 --> P6
  P6 --> END
  END -.->|"Seat transfer"| C3
  C3 --> C2
  classDef action fill:#FFFFFF,stroke:#3A3A3A,stroke-width:1px,color:#222222;
