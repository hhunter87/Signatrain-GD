  "scenarioMeta": [
    {
      "scenarioId": "scenario_accommodation",
      "difficulty": "Intermediate",
      "overview": "An employee sends an accommodation request as a casual text message. You must decide how to treat it, what to document, and whether to involve HR.",
      "objectives": [
        "Recognize an accommodation request in any form",
        "Avoid dismissive responses",
        "Document the request",
        "Know when to loop in HR"
      ],
      "structure": [
        "Intro",
        "Decision point 1",
        "Feedback",
        "Decision point 2",
        "Consequence",
        "Debrief",
        "Mini quiz"
      ],
      "decisionPoints": [
        {
          "prompt": "An employee texts: 'my back is really bad, can I work from home more?' What do you do first?",
          "options": [
            {
              "text": "Reply casually that it's fine for now",
              "outcome": "risky",
              "feedback": "A verbal OK can create inconsistent, undocumented accommodations.",
              "risk": true
            },
            {
              "text": "Acknowledge, ask clarifying questions, and start documentation",
              "outcome": "good",
              "feedback": "Treating it as a potential accommodation request and documenting is the safest first step.",
              "risk": false
            },
            {
              "text": "Tell them to submit a formal request or it doesn't count",
              "outcome": "risky",
              "feedback": "Requests don't need a specific form; dismissing it can create exposure.",
              "risk": true
            }
          ]
        },
        {
          "prompt": "They share more detail. What next?",
          "options": [
            {
              "text": "Loop in HR and begin the interactive process",
              "outcome": "good",
              "feedback": "Involving HR early keeps the process consistent and compliant.",
              "risk": false
            },
            {
              "text": "Decide on your own what accommodation to grant",
              "outcome": "risky",
              "feedback": "Unilateral decisions bypass the interactive process.",
              "risk": true
            }
          ]
        }
      ],
      "result": {
        "score": 88,
        "strengths": [
          "Recognized the request",
          "Documented appropriately"
        ],
        "riskAreas": [
          "Escalation timing"
        ],
        "recommended": "Review the 'Documentation and Escalation' module."
      }
    },
    {
      "scenarioId": "scenario_complaint_intake",
      "difficulty": "Intermediate",
      "overview": "A team member approaches you with a sensitive workplace complaint. You must decide how to respond, what to document, and when to escalate.",
      "objectives": [
        "Respond without escalating risk",
        "Document the concern",
        "Escalate to HR appropriately",
        "Avoid promising absolute confidentiality"
      ],
      "structure": [
        "Intro",
        "Decision point 1",
        "Feedback",
        "Decision point 2",
        "Consequence",
        "Debrief",
        "Mini quiz"
      ],
      "decisionPoints": [
        {
          "prompt": "An employee says they feel targeted by their supervisor. What do you do first?",
          "options": [
            {
              "text": "Tell them to work it out directly with the supervisor",
              "outcome": "risky",
              "feedback": "This can discourage reporting and increase risk.",
              "risk": true
            },
            {
              "text": "Ask clarifying questions and document the concern",
              "outcome": "good",
              "feedback": "Listening, clarifying, and documenting is the right first move.",
              "risk": false
            },
            {
              "text": "Promise complete confidentiality no matter what",
              "outcome": "risky",
              "feedback": "You generally can't guarantee absolute confidentiality.",
              "risk": true
            },
            {
              "text": "Wait until they submit a written complaint",
              "outcome": "risky",
              "feedback": "Delay can worsen the situation and create liability.",
              "risk": true
            }
          ]
        },
        {
          "prompt": "After documenting, what next?",
          "options": [
            {
              "text": "Escalate to your HR contact",
              "outcome": "good",
              "feedback": "Timely escalation to HR is appropriate.",
              "risk": false
            },
            {
              "text": "Investigate it yourself quietly",
              "outcome": "risky",
              "feedback": "Untrained solo investigations can compromise the process.",
              "risk": true
            }
          ]
        }
      ],
      "result": {
        "score": 0,
        "strengths": [],
        "riskAreas": [],
        "recommended": "Then review 'Documentation and Escalation'."
      }
    }
  ],
